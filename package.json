{
  "name": "nextra-template",
  "private": true,
  "version": "0.1.0",
  "description": "Template for a Nextra site — landing, blog and docs — that deploys to GitHub Pages out of the box.",
  "license": "MIT",
  "author": "Jan Ole Suhr",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "postbuild": "pagefind --site out --output-path out/_pagefind",
    "dev": "next dev",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:fix": "eslint . --cache --cache-strategy content --fix",
    "ok": "pnpm run build && pnpm run typecheck && pnpm run lint:fix && pnpm run test",
    "qa": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.1.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "16.0.0",
    "pagefind": "1.5.2",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "nextra>zod": "4.3.0",
      "nextra-theme-docs>zod": "4.3.0"
    }
  }
}
