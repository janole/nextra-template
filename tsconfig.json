{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Next-specific additions on top of the house base: the DOM lib, the JSX
    // runtime Next mandates, and `allowJs` for the `_meta.js` / `mdx-components.js`
    // files Nextra expects at those exact paths.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "out", ".next"]
}
